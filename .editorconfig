root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{mjs,js}]
indent_style = space
indent_size = 2

[*.{css,html,json,jsonc}]
indent_style = space
indent_size = 4

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
