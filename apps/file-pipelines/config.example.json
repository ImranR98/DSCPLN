{
  "configVersion": 1,
  "bindHost": "127.0.0.1",
  "port": 8791,
  "concurrency": 2,
  "paused": false,
  "dryRun": false,
  "trashRetentionDays": 30,
  "settleSeconds": 60,
  "maxAutoRetries": 3,
  "stagingDir": "~/.file-pipelines/staging",
  "reviewDir": "~/.file-pipelines/review",
  "trashDir": "~/.file-pipelines/trash",
  "logDir": "~/.file-pipelines/logs",
  "syncLockFile": "~/.file-pipelines/lock.json",
  "lockHeartbeatSeconds": 300,
  "lockStaleSeconds": 900,
  "ntfy": {
    "url": "",
    "token": "",
    "notifySuccess": true
  },
  "folders": [
    {
      "name": "Camera",
      "source": "~/PhoneSync/Camera",
      "destination": "~/Media/Camera",
      "method": "standardize",
      "settleSeconds": 60
    },
    {
      "name": "Screenshots",
      "source": "~/PhoneSync/Screenshots",
      "destination": "~/Media/Screenshots",
      "method": "standardize",
      "settleSeconds": 60
    }
  ]
}
