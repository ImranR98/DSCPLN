{
  "name": "dscpln-file-pipelines",
  "version": "1.0.0",
  "description": "File Pipelines \u2014 watch configured folders, standardize/concat/copy media into destination folders, and clean up originals only when it is safe to do so.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "file-pipelines": "./bin/file-pipelines.js"
  },
  "scripts": {
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "start": "node src/index.js",
    "test": "npm run build:ui && node --test --test-concurrency=1"
  },
  "dependencies": {
    "@dscpln/server-kit": "*",
    "chokidar": "^6.0.0",
    "exiftool-vendored": "^39.0.0"
  },
  "devDependencies": {
    "@dscpln/ui-kit": "*",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
