{
  "name": "dscpln-media-sync",
  "version": "1.0.0",
  "description": "Media Sync \u2014 watch configured folders, standardize/concat/copy media into destination folders, and clean up originals only when it is safe to do so.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "media-sync": "./bin/media-sync.js"
  },
  "scripts": {
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "start": "node src/index.js",
    "test": "npm run build:ui && node --test --test-concurrency=1"
  },
  "dependencies": {
    "@dscpln/server-kit": "*",
    "chokidar": "^4.0.3",
    "exiftool-vendored": "^35.0.0"
  },
  "devDependencies": {
    "@dscpln/ui-kit": "*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  }
}
