# Media Sync ExifTool user configuration.
# Defines the XMP-media-sync namespace used to record which source clips were
# concatenated into a snap-group output and the expected duration.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        media-sync => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::media-sync' },
        },
    },
);

%Image::ExifTool::UserDefined::media-sync = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-media-sync', 2 => 'Other' },
    NAMESPACE => { 'media-sync' => 'http://ns.media-sync.local/1.0/' },
    WRITABLE  => 'string',
    Inputs    => { },
    ExpectedDuration => { },
    GroupId   => { },
);

1;  #end
