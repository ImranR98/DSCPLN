{
  "name": "dscpln-task-runner",
  "version": "3.0.0",
  "description": "Task Runner: local web GUI for config-driven backup workflows",
  "type": "module",
  "private": true,
  "bin": {
    "task-runner": "server.mjs"
  },
  "scripts": {
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "start": "node server.mjs --no-browser",
    "test": "npm run build:ui && node --test"
  },
  "dependencies": {
    "@dscpln/server-kit": "*",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@dscpln/ui-kit": "*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "@dscpln/test-kit": "*"
  }
}
