{
  "name": "dscpln-task-runner",
  "version": "3.0.0",
  "description": "Task Runner: run scheduled and on-demand tasks from a web UI",
  "type": "module",
  "private": true,
  "bin": {
    "task-runner": "server.mjs"
  },
  "scripts": {
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "start": "node server.mjs --no-browser",
    "test": "npm run build:ui && node --test"
  },
  "dependencies": {
    "@dscpln/server-kit": "*",
    "express": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@dscpln/ui-kit": "*",
    "vite": "^8.3.4",
    "@dscpln/test-kit": "*",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
