{
  "name": "dscpln",
  "version": "1.0.0",
  "private": true,
  "description": "Every D$CPLN data backup/sync function in one monorepo: a portal, scheduled apps and tools",
  "license": "MIT",
  "author": "Imran Remtulla",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "balance": "npm run start --workspace dscpln-balance-xlsx",
    "mock": "npm run mock --workspace dscpln-balance-xlsx",
    "task-runner": "BACKUPCTL_REPO_DIR=\"$PWD\" node apps/task-runner/server.mjs --no-browser",
    "vendor:shoelace": "npm run vendor --workspace @dscpln/ui-kit"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
