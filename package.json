{
  "name": "dscpln",
  "version": "1.0.0",
  "private": true,
  "description": "Every D$CPLN data backup/sync function in one monorepo: a portal, scheduled apps and tools",
  "license": "MIT",
  "author": "Imran Remtulla",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "check:html": "node scripts/sync-app-html.mjs --check",
    "test": "npm run test --workspaces --if-present",
    "mock": "npm run mock --workspace dscpln-balance-xlsx",
    "ui": "npm run build:ui --workspaces --if-present",
    "balance-xlsx": "npm start --workspace dscpln-balance-xlsx",
    "compose-state": "npm start --workspace dscpln-compose",
    "state-backup": "npm start --workspace dscpln-state-backup",
    "contacts-calendar": "npm start --workspace dscpln-contacts",
    "file-pipelines": "npm start --workspace dscpln-file-pipelines",
    "portal": "npm start --workspace dscpln-portal",
    "task-runner": "npm start --workspace dscpln-task-runner",
    "whatsapp-txt": "npm start --workspace dscpln-watxt",
    "ytmusic": "npm start --workspace dscpln-ytmusic"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1"
  }
}
